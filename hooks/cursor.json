{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "${CURSOR_PLUGIN_ROOT}/hooks/session-start.sh" }
    ],
    "preToolUse": [
      {
        "matcher": "Shell",
        "failClosed": true,
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/guard.sh"
      },
      {
        "matcher": "Write",
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/guard.sh"
      }
    ]
  }
}
